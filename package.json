{
  "name": "staywise",
  "version": "1.3.3",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "netlify:build": "bun install --frozen-lockfile && bun run build",
    "routes:generate": "tsr generate",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:local": "vitest run src/tests/security.integration.test.ts src/tests/guide.integration.test.ts src/tests/guest.integration.test.ts src/tests/translation.integration.test.ts src/tests/messages.integration.test.ts src/tests/restore.integration.test.ts src/tests/hero.integration.test.ts src/tests/agent.integration.test.ts src/tests/agent-oauth.integration.test.ts src/tests/security-activity.integration.test.ts",
    "test:e2e": "playwright test",
    "knip": "knip",
    "audit": "bun audit --audit-level=moderate --ignore GHSA-vfj7-8cjw-p6xm --ignore GHSA-86w9-cpqp-85rv",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run knip",
    "db:start": "bunx supabase@2.121.0 start",
    "db:stop": "bunx supabase@2.121.0 stop",
    "db:reset": "bunx supabase@2.121.0 db reset",
    "db:test": "bunx supabase@2.121.0 test db --local",
    "db:push": "bunx supabase@2.121.0 db push --db-url \"$SUPABASE_DB_URL\"",
    "storage:drain": "bun src/lib/storage-drain.ts",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/alegreya-sans": "5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "lucide-react": "1.61.0",
    "nodemailer": "10.2.1",
    "postgres": "3.4.9",
    "posthog-node": "^5.57.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@netlify/vite-plugin-tanstack-start": "1.3.19",
    "@playwright/test": "1.64.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@tanstack/router-cli": "1.167.46",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "happy-dom": "21.0.4",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "semantic-release": "25.0.9",
    "seroval": "1.7.2",
    "simple-git-hooks": "2.14.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css,md}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{ts,tsx}": "oxlint --deny-warnings"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.3"
}
