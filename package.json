{
  "name": "staywise",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "netlify:build": "bun install --frozen-lockfile && bun run build",
    "routes:generate": "tsr generate",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "knip": "knip",
    "audit": "bun audit --audit-level=moderate",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run knip",
    "db:start": "bunx supabase@2.121.0 start",
    "db:stop": "bunx supabase@2.121.0 stop",
    "db:reset": "bunx supabase@2.121.0 db reset"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@netlify/vite-plugin-tanstack-start": "1.3.19",
    "@tanstack/router-cli": "1.167.45",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "knip": "6.41.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.3"
}
