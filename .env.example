# Copy to .env.local for local development; never commit real values.
# local | preview | production. Required explicitly when NODE_ENV=production.
APP_ENV=local
# Outside APP_ENV=local every value below must be set explicitly; the local defaults are synthetic
# and come from the local Supabase stack (`bun run db:start`) plus supabase/config.toml.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=<publishable key printed by `bunx supabase@2.121.0 status`>
# APP_DB_URL=postgresql://app_runtime:app_runtime_local@127.0.0.1:54322/postgres
# Outside APP_ENV=local, APP_DB_URL must carry verify-full TLS with the project root CA:
# APP_DB_URL=postgresql://app_runtime:<deployment secret>@<host>:5432/postgres?sslmode=verify-full&sslrootcert=/etc/staywise/db-root-ca.pem
# SMTP_URL=smtp://127.0.0.1:54325
# SMTP_FROM=staywise@example.test
# APP_ORIGIN=http://localhost:3000
# SHARE_HMAC_KEY=<at least 32 random characters; keys share-link secret digests and guest rate-limit fingerprints>
# Operator kill switch: true denies all guest exchange, reads, and intake, including old sessions.
# GUEST_ACCESS_DISABLED=false
# Optional: stored guide localisation. When unset, hosts see "Translation is not available right
# now" and nothing is sent anywhere, because translation egress is off by default.
# GOOGLE_TRANSLATE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...","token_uri":"https://oauth2.googleapis.com/token"}
# The account needs Cloud Translation Advanced (EU, europe-west1). Provide it as a deployment
# secret only after the processor/DPA review; the key must never be committed or logged.
